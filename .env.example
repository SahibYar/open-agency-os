# Copy to .env and fill. Never commit .env.

DOMAIN=localhost
TZ=Asia/Karachi

POSTGRES_USER=aperture
POSTGRES_PASSWORD=change-me-now
POSTGRES_DB=aperture
MYSQL_ROOT_PASSWORD=change-me-root
MAUTIC_DB_PASSWORD=change-me-mautic

N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/

TWENTY_SERVER_URL=http://localhost:3000
TWENTY_APP_SECRET=generate-a-32-char-secret

CHATWOOT_SECRET=generate-a-64-char-secret
CHATWOOT_URL=http://localhost:3001

CALCOM_NEXTAUTH_SECRET=generate-a-32-char-secret
CALCOM_ENCRYPTION_KEY=generate-32-char-key
CALCOM_URL=http://localhost:3002

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# API credentials read by the n8n workflows ($env.*).
# These are tokens you create inside each product, not the app secrets above.
# Defaults inside compose use Docker DNS. Override only if the service is not on this network.
TWENTY_URL=http://twenty:3000
TWENTY_TOKEN=
CHATWOOT_INTERNAL_URL=http://chatwoot:3000
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_TOKEN=
MAUTIC_URL=http://mautic
MAUTIC_BASIC=
CALCOM_API_KEY=
CALCOM_INTERNAL_URL=http://calcom:3000
# Base64 of "SID:auth token" — n8n sends this as Authorization: Basic
TWILIO_BASIC=

