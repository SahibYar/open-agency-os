# Copy to .env and fill. Never commit .env.
# Quickest start: bash setup.sh  — generates all secrets automatically.

# ── Core ───────────────────────────────────────────────────────────────────
DOMAIN=example.com
CADDY_EMAIL=ops@example.com
TZ=UTC

# ── Databases ──────────────────────────────────────────────────────────────
POSTGRES_USER=aperture
POSTGRES_PASSWORD=change-me-now
POSTGRES_DB=aperture
MYSQL_ROOT_PASSWORD=change-me-root
MAUTIC_DB_PASSWORD=change-me-mautic
# WordPress gets its own DB user — isolated from Mautic credentials.
WORDPRESS_DB_PASSWORD=change-me-wordpress

# ── n8n ────────────────────────────────────────────────────────────────────
# Set N8N_HOST and N8N_WEBHOOK_URL to your glue.{DOMAIN} subdomain once DNS resolves.
N8N_HOST=localhost
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://glue.example.com/

# ── Twenty (CRM) ───────────────────────────────────────────────────────────
TWENTY_SERVER_URL=https://crm.example.com
TWENTY_APP_SECRET=generate-a-32-char-secret

# ── Chatwoot (Inbox) ────────────────────────────────────────────────────────
CHATWOOT_SECRET=generate-a-64-char-secret
CHATWOOT_URL=https://inbox.example.com

# ── Cal.com (Booking) ───────────────────────────────────────────────────────
CALCOM_NEXTAUTH_SECRET=generate-a-32-char-secret
CALCOM_ENCRYPTION_KEY=generate-32-char-key
CALCOM_URL=https://book.example.com

# ── Twilio (SMS / voice) ────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Base64 of "AccountSID:AuthToken" — used by n8n workflow HTTP auth headers
# Generate: echo -n "ACxxx:your_auth_token" | base64
TWILIO_BASIC=

# ── Workflow settings ───────────────────────────────────────────────────────
# Used by SMS messages sent from n8n workflows
BRAND_NAME=My Agency
BOOKING_PAGE_URL=https://book.example.com
# Google review link for review-request workflow (08)
# Get yours: Google Business Profile → Get more reviews → copy the link
GOOGLE_REVIEW_URL=https://g.page/r/YOUR_GOOGLE_REVIEW_ID/review

# ── API credentials (read by n8n workflows via $env.*) ──────────────────────
# Generate these tokens inside each product after first login.
# Internal Docker DNS defaults shown — only change if a service runs elsewhere.
TWENTY_URL=http://twenty:3000
TWENTY_TOKEN=

CHATWOOT_INTERNAL_URL=http://chatwoot:3000
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_TOKEN=

MAUTIC_URL=http://mautic
MAUTIC_BASIC=
# Segment ID in Mautic for lead nurture enrolment (Mautic > Segments > find the ID)
MAUTIC_NURTURE_SEGMENT_ID=1

CALCOM_API_KEY=
CALCOM_INTERNAL_URL=http://calcom:3000

# ── SSO / Authelia ──────────────────────────────────────────────────────────
# Only required when starting: docker compose --profile sso up -d
# See docs/sso.md for setup and password hash generation.
AUTHELIA_JWT_SECRET=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=
