{
  "name": "Aperture — speed to lead SMS",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "aperture-sms", "responseMode": "onReceived", "options": {} },
      "id": "wh-sms",
      "name": "SMS webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "aperture-sms"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.twilio.com/2010-04-01/Accounts/{{$env.TWILIO_ACCOUNT_SID}}/Messages.json",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Basic {{$env.TWILIO_BASIC}}" }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "To", "value": "={{$json.body.to}}" },
            { "name": "From", "value": "={{$env.TWILIO_FROM}}" },
            { "name": "Body", "value": "={{$json.body.body}}" }
          ]
        },
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "http-twilio",
      "name": "Twilio send SMS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300]
    }
  ],
  "connections": {
    "SMS webhook": { "main": [[{ "node": "Twilio send SMS", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
