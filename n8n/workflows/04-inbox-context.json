        "jsonBody": "={{ JSON.stringify({ content: $json.body.body || $json.body.content, private: true }) }}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "http-note",
      "name": "Chatwoot private note",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [540, 300]
    }
  ],
  "connections": {
    "Note webhook": { "main": [[{ "node": "Chatwoot private note", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
