{
  "name": "Aperture — inbox CRM note",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "aperture-reply", "responseMode": "onReceived", "options": {} },
      "id": "wh-note",
      "name": "Note webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "aperture-reply"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.CHATWOOT_URL}}/api/v1/accounts/{{$env.CHATWOOT_ACCOUNT_ID}}/conversations/{{$json.body.conversationId}}/messages",
