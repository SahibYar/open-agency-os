{
  "name": "Aperture — lead follow-up sequence",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "aperture-lead-followup",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "wh-lead",
      "name": "Lead webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "aperture-lead-followup"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nif (!body.email || !String(body.email).includes('@')) {\n  throw new Error('email required');\n}\nlet phone = String(body.phone || '').replace(/\\D/g, '');\nif (phone.length === 10) phone = '1' + phone;\nif (phone.length >= 10) phone = '+' + phone;\nelse phone = '';\nconst full = String(body.name || '');\nconst firstName = (body.firstName || full.split(' ')[0] || 'there').trim();\nreturn [{ json: {\n  email: body.email.trim().toLowerCase(),\n  firstName,\n  lastName: body.lastName || full.split(' ').slice(1).join(' ') || '-',\n  phone,\n  source: body.source || ''\n} }];"
      },
      "id": "code-validate",
      "name": "Validate & normalise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.twilio.com/2010-04-01/Accounts/{{$env.TWILIO_ACCOUNT_SID}}/Messages.json",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Basic {{$env.TWILIO_BASIC}}" }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "To",   "value": "={{ $json.phone }}" },
            { "name": "From", "value": "={{ $env.TWILIO_FROM }}" },
            { "name": "Body", "value": "=Hey {{ $json.firstName }}, thanks for reaching out to {{ $env.BRAND_NAME }}! We'll be in touch shortly. Book a quick intro call: {{ $env.BOOKING_PAGE_URL }}" }
          ]
        },
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "http-sms-1",
      "name": "Immediate SMS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TWENTY_URL }}/rest/people",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.TWENTY_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: { firstName: $('Validate & normalise').item.json.firstName, lastName: $('Validate & normalise').item.json.lastName }, emails: { primaryEmail: $('Validate & normalise').item.json.email }, phones: { primaryPhoneNumber: $('Validate & normalise').item.json.phone } }) }}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "http-twenty",
      "name": "Twenty create person",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MAUTIC_URL }}/api/contacts/new",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Basic {{ $env.MAUTIC_BASIC }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ firstname: $('Validate & normalise').item.json.firstName, lastname: $('Validate & normalise').item.json.lastName, email: $('Validate & normalise').item.json.email, phone: $('Validate & normalise').item.json.phone }) }}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "http-mautic",
      "name": "Mautic create contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MAUTIC_URL }}/api/segments/{{ $env.MAUTIC_NURTURE_SEGMENT_ID }}/contact/{{ $json.contact.id }}/add",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Basic {{ $env.MAUTIC_BASIC }}" }
          ]
        },
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "http-segment",
      "name": "Mautic nurture segment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 320]
    },
    {
      "parameters": { "unit": "minutes", "amount": 10 },
      "id": "wait-10m",
      "name": "Wait 10 min",
      "type": "n8n-nodes-base.wait",
