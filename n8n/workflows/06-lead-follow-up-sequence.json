        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Basic {{$env.TWILIO_BASIC}}" }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "To",   "value": "={{ $('Validate & normalise').item.json.phone }}" },
            { "name": "From", "value": "={{ $env.TWILIO_FROM }}" },
            { "name": "Body", "value": "=Hi {{ $('Validate & normalise').item.json.firstName }}, still here if you have questions! Reply anytime or grab a time: {{ $env.BOOKING_PAGE_URL }}" }
          ]
        },
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "http-sms-2",
      "name": "10-min follow-up SMS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 180]
    }
  ],
